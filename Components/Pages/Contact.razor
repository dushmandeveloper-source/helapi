@page "/contact"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Contact Us - Hela Api Tea House</PageTitle>

<style>
    @@keyframes pan-bg {
        0% { transform: scale(1.05) translate(0px, 0px); }
        100% { transform: scale(1.15) translate(-1.5%, -1.5%); }
    }
    .animate-pan-bg { animation: pan-bg 25s ease-in-out infinite alternate; }
</style>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-hidden">
    <SiteHeader />

    @* Page Header *@
    <section class="relative py-24 md:py-32 bg-[#DDE8C8] flex items-center justify-center border-b border-white/50 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-70 mix-blend-multiply animate-pan-bg" style="background-image: url('https://images.unsplash.com/photo-1596040033229-a9821ebd058d?q=80&w=2070&auto=format&fit=crop')"></div>

        <div class="relative z-10 text-center px-4">
            <span class="text-white font-semibold text-sm md:text-base tracking-widest uppercase mb-3 block">We'd Love To Hear From You</span>
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white">Contact Us</h1>
        </div>
    </section>

    @* Contact Info Cards *@
    <section class="py-12 md:py-16 bg-[#FFF9F0]">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8 -mt-1">
                @foreach (var info in contactInfo)
                {
                    <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.05)] border border-gray-100 p-6 md:p-8 text-center hover:shadow-lg transition-all">
                        <div class="w-14 h-14 md:w-16 md:h-16 mx-auto mb-4 rounded-full bg-[#DDE8C8] flex items-center justify-center text-[#5E8C31]">
                            <i data-lucide="@info.Icon" width="26" height="26"></i>
                        </div>
                        <h3 class="font-serif font-bold text-lg md:text-xl text-gray-900 mb-2">@info.Title</h3>
                        @foreach (var line in info.Lines)
                        {
                            <p class="text-sm md:text-base text-gray-500">@line</p>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    @* Form + Map Section *@
    <section class="py-4 pb-16 md:pb-24 bg-[#FFF9F0]">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">

                @* Form *@
                <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.05)] border border-gray-100 p-6 md:p-10">
                    <span class="text-[#B97A4A] font-semibold text-xs md:text-sm tracking-widest uppercase mb-3 block">Send A Message</span>
                    <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mb-6 md:mb-8">
                        Have A Question? Get In Touch
                    </h2>

                    @if (submitted)
                    {
                        <div class="bg-[#DDE8C8] text-[#3F5F22] rounded-lg px-5 py-4 mb-6 flex items-center gap-3 font-semibold">
                            <i data-lucide="check-circle" width="20" height="20"></i>
                            Thank you! Your message has been sent successfully.
                        </div>
                    }

                    <EditForm Model="@formModel" OnValidSubmit="@HandleSubmit">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 mb-4 md:mb-5">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Your Name</label>
                                <input @bind="formModel.Name" type="text" placeholder="John Doe"
                                       class="w-full bg-[#FFF9F0] border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#5E8C31] transition" />
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Your Email</label>
                                <input @bind="formModel.Email" type="email" placeholder="john@example.com"
                                       class="w-full bg-[#FFF9F0] border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#5E8C31] transition" />
                            </div>
                        </div>
                        <div class="mb-4 md:mb-5">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Subject</label>
                            <input @bind="formModel.Subject" type="text" placeholder="How can we help?"
                                   class="w-full bg-[#FFF9F0] border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#5E8C31] transition" />
                        </div>
                        <div class="mb-6 md:mb-8">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Message</label>
                            <textarea @bind="formModel.Message" rows="5" placeholder="Write your message here..."
                                      class="w-full bg-[#FFF9F0] border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#5E8C31] transition resize-none"></textarea>
                        </div>
                        <button type="submit" class="bg-[#5E8C31] hover:bg-[#4a7227] text-white px-8 py-3 rounded-full font-semibold flex items-center gap-2 transition shadow-md w-full sm:w-auto justify-center">
                            Send Message <i data-lucide="send" width="18" height="18"></i>
                        </button>
                    </EditForm>
                </div>

                @* Map / Visit Us *@
                <div class="flex flex-col gap-6">
                    <div class="rounded-2xl overflow-hidden shadow-[0_4px_20px_rgb(0,0,0,0.05)] border border-gray-100 flex-1 min-h-[280px]">
                        <iframe
                            title="Hela Api Tea House Location"
                            src="https://www.google.com/maps?q=Negombo+Road,Kurunegala,Sri+Lanka&output=embed"
                            class="w-full h-full min-h-[280px]"
                            style="border:0;"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>

                    <div class="bg-[#3F5F22] rounded-2xl p-6 md:p-8 text-white">
                        <h3 class="font-serif font-bold text-xl md:text-2xl mb-4">Visit Our Store</h3>
                        <p class="text-sm md:text-base text-white/90 leading-relaxed mb-4">
                            Experience our finest teas, spices and traditional foods in person. Our friendly team is ready to help you find the perfect blend.
                        </p>
                        <div class="flex items-center gap-2 text-sm md:text-base">
                            <i data-lucide="clock" width="18" height="18" class="text-[#D4A437]"></i>
                            Mon - Sat: 9:00 AM - 6:00 PM, Sunday: Closed
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <SiteFooter />
</div>

@code {
    private record ContactInfo(string Icon, string Title, string[] Lines);

    private readonly List<ContactInfo> contactInfo = new()
    {
        new("map-pin", "Our Address", new[] { "Negombo Road,", "Kurunegala, Sri Lanka" }),
        new("phone", "Call Us", new[] { "+94 74 062 2387" }),
        new("mail", "Email Us", new[] { "info@helaapi.com", "support@helaapi.com" }),
    };

    private ContactFormModel formModel = new();
    private bool submitted = false;

    private void HandleSubmit()
    {
        submitted = true;
        formModel = new ContactFormModel();
    }

    private class ContactFormModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteInterop.createIcons");
    }
}
