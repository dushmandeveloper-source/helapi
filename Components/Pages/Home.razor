@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Hela Api</PageTitle>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-clip">
    <SiteHeader />

    @* Hero Banner Slider *@
    <section class="relative h-[80vh] min-h-[500px] lg:h-[700px] bg-gray-900 overflow-hidden flex items-center">
        @for (var i = 0; i < heroSlides.Count; i++)
        {
            var index = i;
            var slide = heroSlides[index];
            <div class="@($"absolute inset-0 transition-opacity duration-1000 ease-in-out {(index == heroIndex ? "opacity-100 z-10" : "opacity-0 z-0")}")">
                <div class="@($"absolute inset-0 bg-cover bg-center transition-transform duration-[10000ms] ease-linear {(index == heroIndex ? "scale-110" : "scale-100")}")"
                     style="@($"background-image: url('{slide.Image}')")"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/25 to-transparent"></div>

                <div class="container mx-auto px-4 lg:px-12 h-full relative z-20 flex items-center">
                    <div class="max-w-2xl mt-12 lg:mt-0 text-white w-full">
                        @if (index == heroIndex)
                        {
                            <p class="anim-fade text-sm md:text-lg font-medium tracking-wider mb-2 flex items-center gap-2 text-gray-200">
                                Welcome to <span class="text-[#D4A437] font-bold">Hela Api</span>
                            </p>
                            <h1 class="text-4xl md:text-5xl lg:text-7xl font-serif font-bold leading-[1.1] mb-4 md:mb-6 text-white drop-shadow-md">
                                <div class="overflow-hidden pb-1"><div class="anim-title">@slide.Title1 <span class="text-[#D4A437]">@slide.Title2</span>,</div></div>
                                <div class="overflow-hidden pb-1"><div class="anim-title">@slide.Title3 <span class="text-[#D4A437]">@slide.Title4</span> &amp;</div></div>
                                <div class="overflow-hidden pb-1"><div class="anim-title">@slide.Title5 <span class="text-[#D4A437]">@slide.Title6</span></div></div>
                            </h1>
                            <p class="anim-fade text-base md:text-xl mb-8 md:mb-10 text-gray-200 font-light max-w-lg drop-shadow-sm">
                                @slide.Subtitle
                            </p>
                            <div class="anim-fade flex flex-wrap gap-4">
                                <a href="/products" class="bg-[#5E8C31] hover:bg-[#4a7227] text-white px-6 md:px-8 py-3 rounded-full font-semibold flex items-center gap-2 transition shadow-lg text-sm md:text-base">
                                    <i data-lucide="leaf" width="18" height="18"></i> Shop Now
                                </a>
                                <a href="/products" class="border border-white/60 hover:border-white hover:bg-white/10 text-white px-6 md:px-8 py-3 rounded-full font-semibold flex items-center gap-2 transition backdrop-blur-sm text-sm md:text-base">
                                    Explore More <i data-lucide="arrow-right" width="18" height="18"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* Carousel Indicators *@
        <div class="absolute bottom-8 left-0 right-0 z-30 flex justify-center gap-3">
            @for (var i = 0; i < heroSlides.Count; i++)
            {
                var idx = i;
                <button @onclick="() => SetHeroIndex(idx)"
                        class="@($"h-2 rounded-full transition-all duration-500 {(idx == heroIndex ? "w-8 bg-[#D4A437]" : "w-2 bg-white/50 hover:bg-white/80")}")"
                        aria-label="@($"Go to slide {idx + 1}")">
                </button>
            }
        </div>
    </section>

    @* Features Bar *@
    <section class="bg-[#FFF9F0] py-8 md:py-12 border-b border-gray-200">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8">
                <div class="flex flex-col items-center text-center gap-2 sm:flex-row sm:items-center sm:text-left sm:gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100 sm:bg-transparent sm:p-0 sm:shadow-none sm:border-none">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#DDE8C8] text-[#5E8C31] flex items-center justify-center shrink-0 border border-[#cfe0b6]">
                        <i data-lucide="leaf" width="24" height="24" class="md:w-7 md:h-7"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm md:text-base">100% Pure Ceylon</h4>
                        <p class="text-xs md:text-sm text-gray-500 leading-tight mt-1">Finest products from<br />Sri Lankan nature</p>
                    </div>
                </div>
                <div class="flex flex-col items-center text-center gap-2 sm:flex-row sm:items-center sm:text-left sm:gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100 sm:bg-transparent sm:p-0 sm:shadow-none sm:border-none">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#FBEBD6] text-[#D4A437] flex items-center justify-center shrink-0 border border-[#f3dcb8]">
                        <i data-lucide="star" width="24" height="24" class="md:w-7 md:h-7"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm md:text-base">Authentic &amp; Natural</h4>
                        <p class="text-xs md:text-sm text-gray-500 leading-tight mt-1">No artificial additives,<br />just pure goodness</p>
                    </div>
                </div>
                <div class="flex flex-col items-center text-center gap-2 sm:flex-row sm:items-center sm:text-left sm:gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100 sm:bg-transparent sm:p-0 sm:shadow-none sm:border-none">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#F3E3D6] text-[#B97A4A] flex items-center justify-center shrink-0 border border-[#e8cfba]">
                        <i data-lucide="shield-check" width="24" height="24" class="md:w-7 md:h-7"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm md:text-base">Traditional Heritage</h4>
                        <p class="text-xs md:text-sm text-gray-500 leading-tight mt-1">Made with traditional<br />Sri Lankan recipes</p>
                    </div>
                </div>
                <div class="flex flex-col items-center text-center gap-2 sm:flex-row sm:items-center sm:text-left sm:gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100 sm:bg-transparent sm:p-0 sm:shadow-none sm:border-none">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#DDE8C8] text-[#5E8C31] flex items-center justify-center shrink-0 border border-[#cfe0b6]">
                        <i data-lucide="globe" width="24" height="24" class="md:w-7 md:h-7"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm md:text-base">Worldwide Delivery</h4>
                        <p class="text-xs md:text-sm text-gray-500 leading-tight mt-1">Delivering freshness<br />to your door</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Categories Section *@
    <section class="py-12 md:py-16 bg-white">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="text-center mb-10">
                <div class="flex items-center justify-center gap-2 text-[#5E8C31] font-semibold tracking-widest text-xs md:text-sm mb-3">
                    <span class="w-6 md:w-8 h-[1px] bg-[#5E8C31]"></span>
                    SHOP BY CATEGORY
                    <i data-lucide="leaf" width="14" height="14"></i>
                </div>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900">Explore Our Collections</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var cat in ProductCatalog.Categories)
                {
                    <a href="/products/@cat.Slug" class="relative h-60 md:h-72 rounded-2xl overflow-hidden group cursor-pointer block">
                        <div class="absolute inset-0 bg-black/30 z-10 transition group-hover:bg-black/45"></div>
                        <img src="@cat.Image" alt="@cat.ShortName"
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                        <div class="absolute inset-0 z-20 p-6 md:p-7 flex flex-col justify-end text-white">
                            <div class="w-11 h-11 bg-white/90 rounded-full flex items-center justify-center text-[#5E8C31] shadow mb-3">
                                <i data-lucide="@cat.Icon" width="22" height="22"></i>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-serif font-bold mb-1">@cat.ShortName</h3>
                            <p class="text-sm text-gray-200 mb-4 leading-relaxed line-clamp-2 max-w-xs">@cat.CardText</p>
                            <span class="self-start bg-white/20 group-hover:bg-[#D4A437] group-hover:text-gray-900 border border-white/40 backdrop-blur-sm px-5 py-2 rounded-full text-sm font-semibold inline-flex items-center gap-2 transition duration-300">
                                Explore <i data-lucide="arrow-right" width="14" height="14"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* Our Products Preview - Tabbed (6 per category + See More) *@
    <section class="py-12 md:py-16 bg-[#FFF9F0] overflow-hidden">
        <div class="container mx-auto px-4 lg:px-8">

            <div class="text-center mb-8 md:mb-10">
                <div class="flex items-center justify-center gap-2 text-[#5E8C31] font-semibold tracking-widest text-xs md:text-sm mb-3">
                    <span class="w-6 md:w-8 h-[1px] bg-[#5E8C31]"></span>
                    OUR PRODUCTS
                    <i data-lucide="leaf" width="14" height="14"></i>
                </div>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900">A Taste of Each Collection</h2>
            </div>

            @* Category Tabs *@
            <div class="flex flex-wrap justify-center gap-2 md:gap-3 mb-10">
                @foreach (var cat in ProductCatalog.Categories)
                {
                    <button @onclick="() => SelectCategory(cat.Slug)"
                            class="@($"px-4 md:px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 inline-flex items-center gap-2 {(cat.Slug == selectedSlug ? "bg-[#5E8C31] text-white border-[#5E8C31] shadow" : "bg-white text-gray-600 border-[#DDE8C8] hover:border-[#5E8C31] hover:text-[#5E8C31]")}")">
                        <i data-lucide="@cat.Icon" width="15" height="15"></i> @cat.ShortName
                    </button>
                }
            </div>

            @* Preview grid: 6 products *@
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
                @foreach (var item in PreviewItems)
                {
                    <a href="/products/@selectedSlug" class="product-reveal bg-white rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.05)] border border-gray-100 overflow-hidden group flex flex-col hover:shadow-lg transition-all">
                        <div class="relative h-32 md:h-40 overflow-hidden bg-[#DDE8C8]/30">
                            <img src="@item.Image" alt="@item.Name" loading="lazy"
                                 class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                        </div>
                        <div class="p-3 md:p-4 flex flex-col flex-grow">
                            <h4 class="font-bold text-gray-900 text-sm mb-1 line-clamp-1 group-hover:text-[#5E8C31] transition-colors">@item.Name</h4>
                            <p class="text-xs text-gray-500 leading-relaxed line-clamp-2">@item.Description</p>
                        </div>
                    </a>
                }
            </div>

            @* See More *@
            <div class="text-center mt-10">
                <a href="/products/@selectedSlug" class="inline-flex items-center gap-2 bg-[#B97A4A] hover:bg-[#a4683c] text-white px-7 py-3 rounded-full font-semibold transition shadow-md">
                    See All @Current.ItemCount @Current.ShortName Products <i data-lucide="arrow-right" width="18" height="18"></i>
                </a>
            </div>

        </div>
    </section>

    @* Why Choose Us *@
    <section class="py-12 md:py-16 bg-[#DDE8C8] border-t border-b border-gray-200">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-center">

                @* Left Side *@
                <div class="lg:w-1/3 text-center lg:text-left">
                    <span class="text-[#B97A4A] font-semibold text-xs md:text-sm tracking-widest uppercase mb-3 block">WHY CHOOSE HELA API</span>
                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold text-gray-900 leading-tight mb-6 md:mb-8">
                        Quality You Can Trust, Every Time.
                    </h2>
                    <a href="/about" class="bg-[#3F5F22] hover:bg-[#5E8C31] text-white px-6 md:px-8 py-3 rounded-full font-semibold inline-flex items-center gap-2 transition shadow-md mx-auto lg:mx-0">
                        Learn More <i data-lucide="arrow-right" width="18" height="18"></i>
                    </a>
                </div>

                @* Right Side - Features Grid *@
                <div class="lg:w-2/3 grid grid-cols-2 gap-y-8 gap-x-4 md:gap-x-8 mt-8 lg:mt-0">

                    <div class="text-center md:text-left flex flex-col items-center md:items-start p-4 bg-white rounded-xl shadow-sm border border-[#FFF9F0] lg:bg-transparent lg:shadow-none lg:border-none lg:p-0">
                        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#FFF9F0] shadow-sm flex items-center justify-center text-[#5E8C31] mb-3 md:mb-4">
                            <i data-lucide="leaf" width="24" height="24" class="md:w-8 md:h-8"></i>
                        </div>
                        <h4 class="font-bold text-base md:text-lg text-gray-900 mb-1 md:mb-2">100% Natural</h4>
                        <p class="text-gray-500 text-xs md:text-sm">No artificial flavors<br />or preservatives.</p>
                    </div>

                    <div class="text-center md:text-left flex flex-col items-center md:items-start p-4 bg-white rounded-xl shadow-sm border border-[#FFF9F0] lg:bg-transparent lg:shadow-none lg:border-none lg:p-0">
                        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#FFF9F0] shadow-sm flex items-center justify-center text-[#5E8C31] mb-3 md:mb-4">
                            <svg width="24" height="24" class="md:w-8 md:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3a4 4 0 0 0 4-4V6a2 2 0 0 1 4 0v5h3a2 2 0 0 1 2 2l-1 5a2 3 0 0 1-2 2h-7a3 3 0 0 1-3-3" /></svg>
                        </div>
                        <h4 class="font-bold text-base md:text-lg text-gray-900 mb-1 md:mb-2">Carefully Selected</h4>
                        <p class="text-gray-500 text-xs md:text-sm">Handpicked from the<br />best sources.</p>
                    </div>

                    <div class="text-center md:text-left flex flex-col items-center md:items-start p-4 bg-white rounded-xl shadow-sm border border-[#FFF9F0] lg:bg-transparent lg:shadow-none lg:border-none lg:p-0">
                        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#FFF9F0] shadow-sm flex items-center justify-center text-[#5E8C31] mb-3 md:mb-4">
                            <i data-lucide="shield-check" width="24" height="24" class="md:w-8 md:h-8"></i>
                        </div>
                        <h4 class="font-bold text-base md:text-lg text-gray-900 mb-1 md:mb-2">Export Quality</h4>
                        <p class="text-gray-500 text-xs md:text-sm">International standards<br />you can rely on.</p>
                    </div>

                    <div class="text-center md:text-left flex flex-col items-center md:items-start p-4 bg-white rounded-xl shadow-sm border border-[#FFF9F0] lg:bg-transparent lg:shadow-none lg:border-none lg:p-0">
                        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#FFF9F0] shadow-sm flex items-center justify-center text-[#5E8C31] mb-3 md:mb-4">
                            <svg width="24" height="24" class="md:w-8 md:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <h4 class="font-bold text-base md:text-lg text-gray-900 mb-1 md:mb-2">Customer First</h4>
                        <p class="text-gray-500 text-xs md:text-sm">Your satisfaction is<br />our top priority.</p>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <SiteFooter />
</div>

@code {
    private int heroIndex = 0;
    private Timer? heroTimer;
    private DotNetObjectReference<Home>? dotNetRef;

    private string selectedSlug = ProductCatalog.Categories[0].Slug;
    private bool animateProductsNext = true;
    private bool animateHeroNext = true;

    private ProductCategory Current => ProductCatalog.BySlug(selectedSlug)!;
    private IEnumerable<ProductItem> PreviewItems => Current.AllItems.Take(6);

    private record HeroSlide(int Id, string Image, string Title1, string Title2, string Title3, string Title4, string Title5, string Title6, string Subtitle);

    private readonly List<HeroSlide> heroSlides = new()
    {
        new(1, "/images/site/hero-tea.jpg",
            "Finest", "Harvest", "Direct to", "Cup", "Nature's", "Best",
            "Experience the misty hills of Sri Lanka in every soothing sip."),
        new(2, "/images/site/hero-spices.jpg",
            "Aromatic", "Spices", "Rich", "Heritage", "Global", "Standards",
            "Handpicked, organic spices that define the true Sri Lankan taste."),
    };

    private void SelectCategory(string slug)
    {
        if (selectedSlug == slug) return;
        selectedSlug = slug;
        animateProductsNext = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("siteInterop.init", dotNetRef);
            heroTimer = new Timer(_ => InvokeAsync(NextHero), null, 6000, 6000);
        }

        await JS.InvokeVoidAsync("siteInterop.createIcons");

        if (animateHeroNext)
        {
            animateHeroNext = false;
            await JS.InvokeVoidAsync("siteInterop.animateHero");
        }

        if (animateProductsNext)
        {
            animateProductsNext = false;
            await JS.InvokeVoidAsync("siteInterop.animateProducts");
        }
    }

    [JSInvokable]
    public Task OnResize(int width) => Task.CompletedTask;

    private void SetHeroIndex(int idx)
    {
        heroIndex = idx;
        animateHeroNext = true;
    }

    private void NextHero()
    {
        heroIndex = (heroIndex + 1) % heroSlides.Count;
        animateHeroNext = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        heroTimer?.Dispose();
        dotNetRef?.Dispose();
    }
}
