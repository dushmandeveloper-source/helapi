@page "/products/{Category}"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>@(current is null ? "Products" : current.Name) - Hela Api</PageTitle>

<style>
    @@keyframes pan-bg {
        0% { transform: scale(1.05) translate(0px, 0px); }
        100% { transform: scale(1.15) translate(-1.5%, -1.5%); }
    }
    .animate-pan-bg { animation: pan-bg 25s ease-in-out infinite alternate; }
</style>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-hidden">
    <SiteHeader />

    @if (current is null)
    {
        <section class="py-28 md:py-40 bg-[#FFF9F0] text-center">
            <div class="container mx-auto px-4">
                <i data-lucide="package-x" width="48" height="48" class="mx-auto mb-6 text-[#DDE8C8]"></i>
                <h1 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4">Category Not Found</h1>
                <p class="text-gray-600 mb-8">We couldn't find the product category you were looking for.</p>
                <a href="/products" class="inline-flex items-center gap-2 bg-[#5E8C31] hover:bg-[#4d7327] text-white px-7 py-3 rounded-full font-semibold transition shadow-md">
                    <i data-lucide="arrow-left" width="18" height="18"></i> Back to Products
                </a>
            </div>
        </section>
    }
    else
    {
        @* Category Header *@
        <section class="relative py-20 md:py-28 bg-[#DDE8C8] flex items-center justify-center border-b border-white/50 overflow-hidden">
            <div class="absolute inset-0 bg-cover bg-center opacity-60 mix-blend-multiply animate-pan-bg" style="@($"background-image: url('{current.Image}')")"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>

            <div class="relative z-10 text-center px-4 max-w-3xl">
                <span class="text-white font-semibold text-sm md:text-base tracking-widest uppercase mb-3 block">Our Collection</span>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-5 drop-shadow">@current.Name</h1>
                <p class="text-white/90 leading-relaxed text-sm md:text-base max-w-2xl mx-auto drop-shadow-sm">@current.Tagline</p>
            </div>
        </section>

        @* Breadcrumb *@
        <div class="bg-white/60 border-b border-[#DDE8C8]/60">
            <div class="container mx-auto px-4 lg:px-8 py-3 max-w-6xl">
                <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-500">
                    <a href="/" class="hover:text-[#5E8C31] transition">Home</a>
                    <i data-lucide="chevron-right" width="14" height="14"></i>
                    <a href="/products" class="hover:text-[#5E8C31] transition">Products</a>
                    <i data-lucide="chevron-right" width="14" height="14"></i>
                    <span class="text-[#5E8C31] font-semibold">@current.Name</span>
                </nav>
            </div>
        </div>

        @* Products *@
        <section class="py-14 md:py-20 bg-[#FFF9F0]">
            <div class="container mx-auto px-4 lg:px-8 max-w-6xl">

                @foreach (var group in current.Groups)
                {
                    <div class="mb-14 last:mb-0">
                        @if (!string.IsNullOrEmpty(group.Title))
                        {
                            <div class="flex items-center gap-4 mb-7">
                                <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#5E8C31] whitespace-nowrap">@group.Title</h2>
                                <span class="flex-grow h-px bg-[#DDE8C8]"></span>
                                <span class="text-xs text-gray-400 font-semibold whitespace-nowrap">@group.Items.Count item@(group.Items.Count == 1 ? "" : "s")</span>
                            </div>
                        }

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
                            @foreach (var item in group.Items)
                            {
                                <div class="product-reveal bg-white rounded-2xl border border-[#DDE8C8]/50 shadow-[0_4px_20px_rgb(0,0,0,0.04)] hover:shadow-[0_12px_28px_rgb(94,140,49,0.12)] hover:-translate-y-1 transition-all duration-300 group overflow-hidden flex flex-col">
                                    <div class="relative h-40 overflow-hidden bg-[#DDE8C8]/30">
                                        <img src="@item.Image" alt="@item.Name" loading="lazy"
                                             class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                    </div>
                                    <div class="p-5 flex flex-col flex-grow">
                                        <h3 class="font-bold text-gray-900 mb-2 flex items-start gap-2 group-hover:text-[#5E8C31] transition-colors">
                                            <span class="text-[#D4A437] mt-0.5 shrink-0">✦</span> <span>@item.Name</span>
                                        </h3>
                                        <p class="text-sm text-gray-600 leading-relaxed">@item.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* CTA *@
                <div class="mt-16 bg-[#DDE8C8]/40 border border-[#DDE8C8] rounded-2xl p-8 md:p-10 text-center">
                    <h3 class="text-xl md:text-2xl font-serif font-bold text-gray-900 mb-3">Interested in our @current.Name?</h3>
                    <p class="text-gray-600 mb-6 max-w-xl mx-auto text-sm md:text-base">Reach out to learn more about availability, wholesale, and export options.</p>
                    <div class="flex flex-wrap items-center justify-center gap-4">
                        <a href="/contact" class="inline-flex items-center gap-2 bg-[#B97A4A] hover:bg-[#a4683c] text-white px-7 py-3 rounded-full font-semibold transition shadow-md">
                            Inquire Now <i data-lucide="arrow-right" width="18" height="18"></i>
                        </a>
                        <a href="/products" class="inline-flex items-center gap-2 text-[#5E8C31] hover:text-[#4d7327] font-semibold transition">
                            <i data-lucide="arrow-left" width="18" height="18"></i> All Categories
                        </a>
                    </div>
                </div>

            </div>
        </section>
    }

    <SiteFooter />
</div>

@code {
    [Parameter] public string Category { get; set; } = "";

    private ProductCategory? current;

    protected override void OnParametersSet()
    {
        current = ProductCatalog.BySlug(Category);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteInterop.createIcons");
        await JS.InvokeVoidAsync("siteInterop.animateProducts");
    }
}
