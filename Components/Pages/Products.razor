@page "/products"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Products - Hela Api Tea House</PageTitle>

<style>
    @@keyframes pan-bg {
        0% { transform: scale(1.05) translate(0px, 0px); }
        100% { transform: scale(1.15) translate(-1.5%, -1.5%); }
    }
    .animate-pan-bg { animation: pan-bg 25s ease-in-out infinite alternate; }
</style>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-hidden">
    <SiteHeader />

    @* Page Header *@
    <section class="relative py-24 md:py-32 bg-[#DDE8C8] flex items-center justify-center border-b border-white/50 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-70 mix-blend-multiply animate-pan-bg" style="background-image: url('https://images.unsplash.com/photo-1582793988951-9aed5509eb97?q=80&w=2070&auto=format&fit=crop')"></div>

        <div class="relative z-10 text-center px-4">
            <span class="text-white font-semibold text-sm md:text-base tracking-widest uppercase mb-3 block">Our Collection</span>
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white">Products</h1>
        </div>
    </section>

    @* Collections Overview *@
    <section class="py-12 md:py-16 bg-[#FFF9F0]">
        <div class="container mx-auto px-4 lg:px-8">
            <div class="text-center mb-10">
                <span class="text-[#B97A4A] font-semibold text-xs md:text-sm tracking-widest uppercase mb-3 block">Our Collections</span>
                <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900">What Hela Api Brings You</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                <div class="bg-[#DDE8C8]/40 rounded-2xl p-6 md:p-8 border border-[#DDE8C8]">
                    <div class="w-12 h-12 bg-[#5E8C31] text-white rounded-full flex items-center justify-center mb-4">
                        <i data-lucide="leaf" width="22" height="22"></i>
                    </div>
                    <h3 class="font-serif font-bold text-lg md:text-xl text-gray-900 mb-2">Premium Ceylon Tea</h3>
                    <p class="text-sm text-gray-600 leading-relaxed">Carefully selected, high-grade single-origin teas embodying the distinct purity and rich character of Sri Lankan hills.</p>
                </div>
                <div class="bg-[#FBF1E4] rounded-2xl p-6 md:p-8 border border-[#F0E1CB]">
                    <div class="w-12 h-12 bg-[#B97A4A] text-white rounded-full flex items-center justify-center mb-4">
                        <i data-lucide="flame" width="22" height="22"></i>
                    </div>
                    <h3 class="font-serif font-bold text-lg md:text-xl text-gray-900 mb-2">Pure Spices of Ceylon</h3>
                    <p class="text-sm text-gray-600 leading-relaxed">Unadulterated, intensely aromatic spice selections sourced directly to bring authentic island flavors to local and global tables.</p>
                </div>
                <div class="bg-[#FFF3D6] rounded-2xl p-6 md:p-8 border border-[#F5E6BC]">
                    <div class="w-12 h-12 bg-[#D4A437] text-white rounded-full flex items-center justify-center mb-4">
                        <i data-lucide="package" width="22" height="22"></i>
                    </div>
                    <h3 class="font-serif font-bold text-lg md:text-xl text-gray-900 mb-2">Hela Heritage Collection</h3>
                    <p class="text-sm text-gray-600 leading-relaxed">Curated traditional Sri Lankan agricultural items, artisanal crafts, and specialized food products rich in regional history.</p>
                </div>
            </div>
        </div>
    </section>

    @* Products Section *@
    <section class="pb-12 md:pb-16 bg-[#FFF9F0]">
        <div class="container mx-auto px-4 lg:px-8">

            @* Filter Bar *@
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
                <div>
                    <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900">All Products</h2>
                    <p class="text-sm text-gray-500 mt-1">@filteredProducts.Count item@(filteredProducts.Count == 1 ? "" : "s") found</p>
                </div>

                <div class="relative w-full sm:w-64">
                    <label class="block text-xs font-semibold tracking-widest uppercase text-[#5E8C31] mb-2">Category</label>
                    <div class="relative">
                        <select @bind="selectedCategory"
                                class="w-full appearance-none bg-white border border-[#DDE8C8] rounded-full px-5 py-3 pr-10 text-sm font-semibold text-gray-700 focus:outline-none focus:border-[#5E8C31] cursor-pointer shadow-sm transition">
                            @foreach (var category in categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                        <i data-lucide="chevron-down" width="18" height="18" class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[#5E8C31]"></i>
                    </div>
                </div>
            </div>

            @* Products Grid *@
            @if (filteredProducts.Count == 0)
            {
                <div class="text-center py-16 text-gray-500">
                    <i data-lucide="search-x" width="40" height="40" class="mx-auto mb-4 text-[#DDE8C8]"></i>
                    No products found in this category.
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                    @foreach (var product in filteredProducts)
                    {
                        <div class="bg-white rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.05)] border border-gray-100 p-3 md:p-4 h-full flex flex-col group cursor-pointer hover:shadow-lg transition-all">
                            <div class="@($"h-40 md:h-48 {product.Bg} rounded-lg mb-4 flex items-center justify-center relative overflow-hidden")">
                                <img src="@product.Img" alt="@product.Name" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute top-2 right-2 w-8 h-8 rounded-full bg-white/80 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-gray-400 hover:text-red-500">
                                    <i data-lucide="heart" width="16" height="16"></i>
                                </div>
                                <span class="absolute top-2 left-2 bg-[#5E8C31] text-white text-[10px] font-semibold uppercase tracking-wider px-2 py-1 rounded-full">@product.Category</span>
                            </div>
                            <h4 class="font-bold text-gray-900 text-sm md:text-base mb-1 line-clamp-1 flex-grow">@product.Name</h4>
                            <div class="flex text-[#D4A437] text-[10px] md:text-xs mb-2">
                                <i data-lucide="star" fill="currentColor" width="12" height="12"></i><i data-lucide="star" fill="currentColor" width="12" height="12"></i><i data-lucide="star" fill="currentColor" width="12" height="12"></i><i data-lucide="star" fill="currentColor" width="12" height="12"></i><i data-lucide="star" fill="currentColor" width="12" height="12"></i>
                            </div>
                            <div class="flex justify-between items-center mt-2">
                                <span class="font-bold text-[#5E8C31] text-sm md:text-base">Rs. @product.Price</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <SiteFooter />
</div>

@code {
    private record Product(int Id, string Name, string Price, string Img, string Bg, string Category);

    private const string AllCategory = "All Categories";

    private readonly List<string> categories = new() { AllCategory, "Tea", "Spices" };

    private string selectedCategory = AllCategory;

    private readonly List<Product> products = new()
    {
        new(1, "Ceylon Green Tea", "950.00", "https://images.unsplash.com/photo-1597481499750-3e6b22637e12?q=80&w=400&auto=format&fit=crop", "bg-[#F1F5E9]", "Tea"),
        new(2, "Ceylon Black Tea BOP", "850.00", "https://images.unsplash.com/photo-1564890369478-c89ca6d9cde9?q=80&w=400&auto=format&fit=crop", "bg-[#F1F5E9]", "Tea"),
        new(3, "Ceylon White Tea", "1,250.00", "https://plus.unsplash.com/premium_photo-1730985575682-ce2e30aa19b4?fm=jpg&q=60&w=400&auto=format&fit=crop", "bg-[#F1F5E9]", "Tea"),
        new(9, "Ceylon Silver Tips Tea", "2,450.00", "https://images.unsplash.com/photo-1571934811356-5cc061b6821f?q=80&w=400&auto=format&fit=crop", "bg-[#F1F5E9]", "Tea"),
        new(4, "Ceylon Cinnamon", "750.00", "https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Cinnamomum_verum_spices.jpg/500px-Cinnamomum_verum_spices.jpg", "bg-[#FBF1E4]", "Spices"),
        new(5, "Pure Black Pepper", "650.00", "https://plus.unsplash.com/premium_photo-1668447605666-716a18e15a1d?fm=jpg&q=60&w=400&auto=format&fit=crop", "bg-[#FBF1E4]", "Spices"),
        new(7, "Whole Cardamom", "1,100.00", "https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Cardamom_pods_-_Green_BNC.jpg/500px-Cardamom_pods_-_Green_BNC.jpg", "bg-[#FBF1E4]", "Spices"),
        new(8, "Premium Cloves", "890.00", "https://upload.wikimedia.org/wikipedia/commons/thumb/9/90/2023_Go%C5%BAdziki.jpg/500px-2023_Go%C5%BAdziki.jpg", "bg-[#FBF1E4]", "Spices"),
    };

    private List<Product> filteredProducts =>
        selectedCategory == AllCategory
            ? products
            : products.Where(p => p.Category == selectedCategory).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteInterop.createIcons");
    }
}
