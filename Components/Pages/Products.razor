@page "/products"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Products - Hela Api</PageTitle>

<style>
    @@keyframes pan-bg {
        0% { transform: scale(1.05) translate(0px, 0px); }
        100% { transform: scale(1.15) translate(-1.5%, -1.5%); }
    }
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
    }
    .animate-pan-bg { animation: pan-bg 25s ease-in-out infinite alternate; }
    .animate-float { animation: float 5s ease-in-out infinite; }
</style>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-clip">
    <SiteHeader />

    @* Page Header *@
    <section class="relative py-24 md:py-32 bg-[#DDE8C8] flex items-center justify-center border-b border-white/50 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-70 mix-blend-multiply animate-pan-bg" style="background-image: url('/images/site/hero-tea.jpg')"></div>

        <div class="relative z-10 text-center px-4">
            <span class="text-white font-semibold text-sm md:text-base tracking-widest uppercase mb-3 block">Our Collection</span>
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white">Products</h1>
        </div>
    </section>

    @* Product Categories Grid *@
    <section class="py-16 md:py-24 bg-[#FFF9F0]">
        <div class="container mx-auto px-4 lg:px-8 max-w-6xl">

            <div class="text-center mb-12">
                <div class="flex items-center justify-center gap-2 text-[#5E8C31] font-semibold tracking-widest text-xs md:text-sm mb-3">
                    <span class="w-6 md:w-8 h-[1px] bg-[#5E8C31]"></span>
                    OUR COLLECTIONS
                    <i data-lucide="leaf" width="14" height="14" class="animate-float"></i>
                </div>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900">What Hela Api Brings You</h2>
                <p class="text-gray-600 leading-relaxed mt-4 max-w-2xl mx-auto">
                    Authentic Sri Lankan products crafted with purity, heritage, and care — from premium Ceylon tea to traditional foods that carry the flavors of the island to the world.
                </p>
            </div>

            @* Desktop: 3-column · Tablet: 2-column · Mobile: 1-column *@
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                @foreach (var category in ProductCatalog.Categories)
                {
                    <a href="/products/@category.Slug" class="product-reveal bg-white rounded-2xl border border-[#DDE8C8]/50 shadow-[0_4px_20px_rgb(0,0,0,0.05)] transform transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_28px_rgb(94,140,49,0.12)] group relative overflow-hidden flex flex-col">

                        @* Image header *@
                        <div class="relative h-44 md:h-48 overflow-hidden">
                            <img src="@category.Image" alt="@category.ShortName" loading="lazy"
                                 class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
                            <div class="absolute left-4 bottom-4 flex items-center gap-3">
                                <div class="w-11 h-11 bg-white/90 rounded-full flex items-center justify-center text-[#5E8C31] shadow">
                                    <i data-lucide="@category.Icon" width="22" height="22"></i>
                                </div>
                                <h3 class="text-xl font-serif font-bold text-white drop-shadow">@category.ShortName</h3>
                            </div>
                            <span class="absolute top-3 right-3 bg-[#5E8C31] text-white text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full">@category.ItemCount items</span>
                        </div>

                        <div class="p-6 md:p-7 flex flex-col flex-grow">
                            <p class="text-sm text-gray-600 leading-relaxed group-hover:text-gray-800 transition-colors duration-300 flex-grow">@category.CardText</p>
                            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#B97A4A] group-hover:text-[#5E8C31] transition-colors">
                                View Products <i data-lucide="arrow-right" width="16" height="16" class="transform transition-transform group-hover:translate-x-1"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>

        </div>
    </section>

    <SiteFooter />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteInterop.createIcons");
        await JS.InvokeVoidAsync("siteInterop.animateProducts");
    }
}
