@page "/services"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Our Services - Hela Api Tea House</PageTitle>

<style>
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
    }
    @@keyframes pan-bg {
        0% { transform: scale(1.05) translate(0px, 0px); }
        100% { transform: scale(1.15) translate(-1.5%, -1.5%); }
    }
    .animate-float { animation: float 5s ease-in-out infinite; }
    .animate-float-delayed { animation: float 5s ease-in-out 2.5s infinite; }
    .animate-pan-bg { animation: pan-bg 25s ease-in-out infinite alternate; }
</style>

<div class="font-sans text-gray-800 bg-[#FFF9F0] overflow-x-hidden">
    <SiteHeader />

    @* Hero Section *@
    <section class="relative py-24 md:py-32 bg-[#DDE8C8] flex items-center justify-center border-b border-white/50 overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center opacity-70 mix-blend-multiply animate-pan-bg" style="background-image: url('https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=2070&auto=format&fit=crop')"></div>

        <div class="relative z-10 text-center px-4">
            <span class="text-white font-semibold text-sm md:text-base tracking-widest uppercase mb-3 block">Beyond Products</span>
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white">Our Services</h1>
        </div>
    </section>

    @* Services Section *@
    <section class="relative py-16 md:py-24 bg-[#FFF9F0]">
        <div class="absolute top-40 -left-64 w-[500px] h-[500px] bg-[#DDE8C8]/30 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
        <div class="absolute bottom-20 -right-64 w-[600px] h-[600px] bg-[#D4A437]/10 rounded-full blur-3xl opacity-50 pointer-events-none"></div>

        <div class="container mx-auto px-4 lg:px-8 max-w-5xl relative z-10">

            <div class="text-center mb-16">
                <div class="flex items-center justify-center gap-2 text-[#B97A4A] font-semibold tracking-widest text-xs md:text-sm mb-3">
                    <span class="w-6 md:w-8 h-[1px] bg-[#B97A4A]"></span>
                    PORTFOLIO
                    <i data-lucide="leaf" width="14" height="14" class="animate-float"></i>
                </div>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900">What We Offer</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">

                @* Hela Rasa Restaurant *@
                <div class="bg-white rounded-2xl overflow-hidden border border-[#DDE8C8] shadow-[0_8px_30px_rgb(0,0,0,0.04)] transform transition-all duration-500 hover:-translate-y-3 hover:shadow-xl group">
                    <div class="h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=1200&auto=format&fit=crop" alt="Hela Rasa by Hela Api" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="p-8">
                        <div class="w-14 h-14 bg-[#B97A4A] text-white rounded-full flex items-center justify-center mb-6 shadow-lg -mt-16 relative z-10 border-4 border-white animate-float">
                            <i data-lucide="utensils" width="24" height="24"></i>
                        </div>
                        <h3 class="text-2xl font-serif font-bold text-[#B97A4A] mb-3">Hela Rasa by Hela Api</h3>
                        <p class="text-sm md:text-base text-gray-700 leading-relaxed mb-4">
                            Operating under the hallmark "Hela Rasa by Hela Api", our restaurant chain offers a refined, immersive Sri Lankan dining experience — bringing time-honored recipes and authentic flavors to the modern table.
                        </p>
                        <span class="inline-flex items-center gap-2 text-[#5E8C31] font-semibold text-sm">
                            <i data-lucide="map-pin" width="16" height="16"></i> A refined Sri Lankan dining experience
                        </span>
                    </div>
                </div>

                @* Lanka Loom *@
                <div class="bg-white rounded-2xl overflow-hidden border border-[#DDE8C8] shadow-[0_8px_30px_rgb(0,0,0,0.04)] transform transition-all duration-500 hover:-translate-y-3 hover:shadow-xl group">
                    <div class="h-56 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1528459801416-a9e53bbf4e17?q=80&w=1200&auto=format&fit=crop" alt="Lanka Loom by Hela Api" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                    </div>
                    <div class="p-8">
                        <div class="w-14 h-14 bg-[#5E8C31] text-white rounded-full flex items-center justify-center mb-6 shadow-lg -mt-16 relative z-10 border-4 border-white animate-float-delayed">
                            <i data-lucide="shirt" width="24" height="24"></i>
                        </div>
                        <h3 class="text-2xl font-serif font-bold text-[#5E8C31] mb-3">Lanka Loom by Hela Api</h3>
                        <p class="text-sm md:text-base text-gray-700 leading-relaxed mb-4">
                            A premium venture dedicated to celebrating regional textiles, preserving handloom craftsmanship, and bringing authentic Sri Lankan fashion and timeless design to modern consumers.
                        </p>
                        <span class="inline-flex items-center gap-2 text-[#5E8C31] font-semibold text-sm">
                            <i data-lucide="sparkles" width="16" height="16"></i> Celebrating craftsmanship and timeless design
                        </span>
                    </div>
                </div>

            </div>

            <div class="text-center mt-16">
                <p class="text-gray-700 leading-relaxed text-lg max-w-2xl mx-auto mb-6">
                    Whether you're exploring our premium collections or seeking partnership opportunities, our team is ready to assist you with care and expertise.
                </p>
                <a href="/contact" class="inline-flex items-center gap-2 bg-[#5E8C31] hover:bg-[#4a7227] text-white px-8 py-3 rounded-full font-semibold transition shadow-md">
                    Get In Touch <i data-lucide="arrow-right" width="18" height="18"></i>
                </a>
            </div>

        </div>
    </section>

    <SiteFooter />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteInterop.createIcons");
    }
}
