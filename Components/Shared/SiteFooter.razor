@* Footer *@
<footer class="bg-[#3F5F22] text-white pt-12 md:pt-16 pb-6 border-t-[8px] border-[#D4A437]">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-12 mb-12">

            @* Col 1 *@
            <div class="sm:col-span-2 lg:col-span-1 lg:pr-4 text-center sm:text-left">
                <img src="/images/site/logo-full.png" alt="Hela Api - Authentic Tastes of Real Ingredients" class="h-16 md:h-20 w-auto object-contain mb-5 mx-auto sm:mx-0" />
                <h4 class="text-white font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">ABOUT HELA API</h4>
                <p class="text-sm text-white leading-relaxed mb-6">
                    WE OFFER THE FINEST CEYLON TEA, AUTHENTIC SPICES AND TRADITIONAL SRI LANKAN FOODS, SOURCED FROM NATURE AND MADE WITH HERITAGE.
                </p>
                <ul class="space-y-2 text-sm mb-6">
                    <li class="flex items-center justify-center sm:justify-start gap-2"><i data-lucide="map-pin" width="14" height="14" class="text-[#D4A437] shrink-0"></i> Negombo Road, Kurunegala, Sri Lanka</li>
                    <li class="flex items-center justify-center sm:justify-start gap-2"><i data-lucide="phone" width="14" height="14" class="text-[#D4A437] shrink-0"></i> +94 74 062 2387</li>
                    <li class="flex items-center justify-center sm:justify-start gap-2"><i data-lucide="clock" width="14" height="14" class="text-[#D4A437] shrink-0"></i> Mon - Sat: 9:00 AM - 6:00 PM</li>
                </ul>
                <div class="flex items-center justify-center sm:justify-start gap-3">
                    <div class="w-8 h-8 rounded-full border border-gray-600 flex items-center justify-center hover:bg-[#5E8C31] hover:text-white hover:border-transparent cursor-pointer transition"><i data-lucide="facebook" width="16" height="16"></i></div>
                    <div class="w-8 h-8 rounded-full border border-gray-600 flex items-center justify-center hover:bg-[#5E8C31] hover:text-white hover:border-transparent cursor-pointer transition"><i data-lucide="instagram" width="16" height="16"></i></div>
                    <div class="w-8 h-8 rounded-full border border-gray-600 flex items-center justify-center hover:bg-[#5E8C31] hover:text-white hover:border-transparent cursor-pointer transition">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" /></svg>
                    </div>
                </div>
            </div>

            @* Col 2 *@
            <div>
                <h4 class="text-[#D4A437] font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">QUICK LINKS</h4>
                <ul class="space-y-3 text-sm">
                    <li><a href="/" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Home</a></li>
                    <li><a href="/about" class="hover:text-white hover:translate-x-1 inline-block transition-transform">About Us</a></li>
                    <li><a href="/products" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Products</a></li>
                    <li><a href="/services" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Services</a></li>
                    <li><a href="/contact" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Contact</a></li>
                </ul>
            </div>

            @* Col 3 *@
            <div>
                <h4 class="text-[#D4A437] font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">OUR PRODUCTS</h4>
                <ul class="space-y-3 text-sm">
                    <li><a href="/products/tea" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Premium Tea</a></li>
                    <li><a href="/products/spices" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Authentic Spices</a></li>
                    <li><a href="/products/herbs" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Herbs &amp; Wellness</a></li>
                    <li><a href="/products/heritage" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Heritage Collection</a></li>
                    <li><a href="/products" class="hover:text-white hover:translate-x-1 inline-block transition-transform">All Products</a></li>
                </ul>
            </div>

            @* Col 4 *@
            <div>
                <h4 class="text-[#D4A437] font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">CUSTOMER SERVICE</h4>
                <ul class="space-y-3 text-sm">
                    <li><a href="/services" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Shipping &amp; Delivery</a></li>
                    <li><a href="/contact" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Returns &amp; Refunds</a></li>
                    <li><a href="/about" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Terms &amp; Conditions</a></li>
                    <li><a href="/about" class="hover:text-white hover:translate-x-1 inline-block transition-transform">Privacy Policy</a></li>
                    <li><a href="/contact" class="hover:text-white hover:translate-x-1 inline-block transition-transform">FAQ</a></li>
                </ul>
            </div>

            @* Col 5 *@
            <div class="sm:col-span-2 lg:col-span-1">
                <h4 class="text-[#D4A437] font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">NEWSLETTER</h4>
                <p class="text-sm text-white mb-4">
                    Subscribe to get updates on our latest products and offers.
                </p>
                <div class="flex flex-col space-y-3">
                    <div class="relative">
                        <input type="email"
                               placeholder="Your email address"
                               class="w-full bg-gray-800/50 border border-gray-600 rounded-md px-4 py-3 text-sm text-white focus:outline-none focus:border-[#D4A437] transition-colors" />
                        <button class="absolute right-2 top-1/2 -translate-y-1/2 text-white hover:text-[#D4A437] transition">
                            <i data-lucide="send" width="18" height="18"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        @* Bottom Bar *@
        <div class="border-t border-gray-800 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
            <p class="text-xs text-white order-3 md:order-1">
                &copy; @DateTime.Now.Year Hela Api. All Rights Reserved.
            </p>

            @* Footer Logo *@
            <div class="flex items-center order-1 md:order-2">
                <img src="/images/site/logo-full.png" alt="Hela Api - Authentic Tastes of Real Ingredients" class="h-14 md:h-16 w-auto object-contain" />
            </div>

            @* Payment Icons *@
            <div class="flex items-center gap-2 md:gap-3 text-xs order-2 md:order-3">
                <span class="text-white mr-1 md:mr-2">We Accept</span>
                <div class="px-2 py-1 bg-white rounded flex items-center justify-center text-blue-900 font-bold italic text-[10px] md:text-xs">VISA</div>
                <div class="px-2 py-1 bg-white rounded flex items-center justify-center">
                    <div class="w-2 h-2 md:w-3 md:h-3 rounded-full bg-red-500 mix-blend-multiply"></div>
                    <div class="w-2 h-2 md:w-3 md:h-3 rounded-full bg-yellow-500 mix-blend-multiply -ml-1"></div>
                </div>
            </div>
        </div>
    </div>
</footer>
