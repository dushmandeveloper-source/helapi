@* Top Bar *@
<div class="bg-[#3F5F22] text-white text-xs py-2 px-4 hidden md:flex justify-between items-center">
    <div class="container mx-auto flex justify-center space-x-8">
        <div class="flex items-center gap-4 lg:gap-6">
            <span class="flex items-center gap-1.5"><i data-lucide="leaf" width="14" height="14" class="text-[#D4A437]"></i> 100% Pure Ceylon</span>
            <span class="flex items-center gap-1.5"><i data-lucide="globe" width="14" height="14" class="text-[#D4A437]"></i> Worldwide Delivery</span>
            <span class="flex items-center gap-1.5"><i data-lucide="trophy" width="14" height="14" class="text-[#D4A437]"></i> Export Quality</span>
        </div>
        <div class="flex-1"></div>
        <div class="flex items-center gap-4 lg:gap-6">
            <span class="flex items-center gap-1.5"><i data-lucide="phone" width="14" height="14"></i> +94 74 062 2387</span>
            <span class="flex items-center gap-1.5"><i data-lucide="mail" width="14" height="14"></i> info@helaapi.com</span>
            <div class="flex items-center gap-3 ml-2 lg:ml-4">
                <i data-lucide="facebook" width="14" height="14" class="cursor-pointer hover:text-white transition"></i>
                <i data-lucide="instagram" width="14" height="14" class="cursor-pointer hover:text-white transition"></i>
                <svg class="w-3.5 h-3.5 cursor-pointer hover:text-white transition" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" /></svg>
            </div>
        </div>
    </div>
</div>

@* Main Navigation *@
<nav class="bg-white sticky top-0 z-40 shadow-sm">
    <div class="container mx-auto px-4 lg:px-8 h-16 md:h-20 flex justify-between items-center relative">

        @* Logo Area *@
        <a href="/" class="flex items-center shrink-0 cursor-pointer">
            <img src="/images/site/logo-full-clean.png" alt="Hela Api - Authentic Tastes of Real Ingredients" class="h-12 md:h-16 w-auto object-contain" />
        </a>

        @* Desktop Links *@
        <div class="hidden md:flex items-center space-x-6 lg:space-x-8 font-semibold text-sm tracking-wide ml-4 lg:ml-8">
            <a href="/" class="@(IsActive("/") ? "text-gray-900 border-b-2 border-[#5E8C31] pb-1" : "text-gray-600 hover:text-[#5E8C31] transition")">HOME</a>
            <a href="/about" class="@(IsActive("/about") ? "text-gray-900 border-b-2 border-[#5E8C31] pb-1" : "text-gray-600 hover:text-[#5E8C31] transition")">ABOUT</a>
            <a href="/products" class="@(IsActive("/products") ? "text-gray-900 border-b-2 border-[#5E8C31] pb-1" : "text-gray-600 hover:text-[#5E8C31] transition")">PRODUCTS</a>
            <a href="/services" class="@(IsActive("/services") ? "text-gray-900 border-b-2 border-[#5E8C31] pb-1" : "text-gray-600 hover:text-[#5E8C31] transition")">SERVICES</a>
            <a href="/contact" class="@(IsActive("/contact") ? "text-gray-900 border-b-2 border-[#5E8C31] pb-1" : "text-gray-600 hover:text-[#5E8C31] transition")">CONTACT</a>
        </div>

        @* Mobile Menu Toggle *@
        <div class="md:hidden flex items-center ml-auto gap-4 text-gray-800">
            <button @onclick="ToggleMobileMenu">
                <i data-lucide="@(mobileMenuOpen ? "x" : "menu")" width="28" height="28"></i>
            </button>
        </div>
    </div>

    @* Mobile Dropdown *@
    @if (mobileMenuOpen)
    {
        <div class="md:hidden absolute top-full left-0 w-full bg-white border-t p-4 flex flex-col space-y-4 font-semibold shadow-xl animate__animated animate__fadeInDown animate__faster z-50">
            <a href="/" class="@(IsActive("/") ? "text-[#5E8C31]" : "text-gray-600")">HOME</a>
            <a href="/about" class="@(IsActive("/about") ? "text-[#5E8C31]" : "text-gray-600")">ABOUT</a>
            <a href="/products" class="@(IsActive("/products") ? "text-[#5E8C31]" : "text-gray-600")">PRODUCTS</a>
            <a href="/services" class="@(IsActive("/services") ? "text-[#5E8C31]" : "text-gray-600")">SERVICES</a>
            <a href="/contact" class="@(IsActive("/contact") ? "text-[#5E8C31]" : "text-gray-600")">CONTACT</a>
        </div>
    }
</nav>

@code {
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private bool mobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private bool IsActive(string path)
    {
        var current = "/" + NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
        if (current == "") current = "/";
        return current == path;
    }
}
